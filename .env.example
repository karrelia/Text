# ─────────────────────────────────────────────────────────────
# Обов'язкові
# ─────────────────────────────────────────────────────────────

# Токен від @BotFather
TELEGRAM_BOT_TOKEN=123456:AA...

# Ключ OpenRouter (https://openrouter.ai/keys) — використовується для
# чистки тексту, а також для STT якщо STT_PROVIDER=openrouter
OPENROUTER_API_KEY=sk-or-v1-...

# Кому дозволено користуватись ботом: Telegram user ID через кому.
# Якщо порожньо — бот нікого не пускає і у відповідь показує ваш ID,
# щоб ви могли вписати його сюди й перезапустити.
ALLOWED_USER_IDS=

# ─────────────────────────────────────────────────────────────
# Розпізнавання мови (STT). Провайдер за замовчуванням для нових
# користувачів; кожен може змінити його командою /stt.
#   openai_whisper | groq_whisper | openrouter
# ─────────────────────────────────────────────────────────────
STT_PROVIDER=openai_whisper

# Потрібен якщо STT_PROVIDER=openai_whisper
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_WHISPER_MODEL=whisper-1

# Потрібен якщо STT_PROVIDER=groq_whisper (Groq дешевший і швидший)
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_WHISPER_MODEL=whisper-large-v3

# Модель для STT через OpenRouter (має приймати audio input)
OPENROUTER_AUDIO_MODEL=google/gemini-2.5-flash

# ─────────────────────────────────────────────────────────────
# Модель для чистки/редагування тексту (через OpenRouter)
# ─────────────────────────────────────────────────────────────
LLM_MODEL=google/gemini-2.5-flash
LLM_TEMPERATURE=0.2

# ─────────────────────────────────────────────────────────────
# Ліміти й обробка аудіо
# ─────────────────────────────────────────────────────────────
# Максимальна тривалість одного повідомлення, секунд (0 = без ліміту)
MAX_AUDIO_SECONDS=5400
# Довше аудіо ріжеться на шматки такої тривалості (по паузах у мовленні)
CHUNK_TARGET_SECONDS=600

# ─────────────────────────────────────────────────────────────
# Запуск
# ─────────────────────────────────────────────────────────────
# polling (за замовчуванням, нічого не треба налаштовувати)
# або webhook (потрібен публічний HTTPS-домен)
MODE=polling
WEBHOOK_BASE_URL=
WEBHOOK_PATH=/telegram/webhook
WEBHOOK_SECRET=
WEBAPP_HOST=0.0.0.0
WEBAPP_PORT=8080

# Шлях до SQLite з налаштуваннями користувачів
DB_PATH=data/bot.db

LOG_LEVEL=INFO

# Необов'язково: як бот представляється в рейтингах OpenRouter
OPENROUTER_APP_URL=https://github.com/karrelia/Text
OPENROUTER_APP_TITLE=Voice2Text UA Bot
